{
  "name": "mpassword-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mPassword - zero-knowledge password manager for Chrome (MV3)",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node build.mjs --e2e && node e2e/run.mjs"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
